  }
  else
  {
    p.rx = 0.707048714f; p.ry = 0.292951226f; p.gx = 0.190212011f; p.gy = 0.775366306f; p.bx = 0.129248619f; p.by = 0.047143653f;
    p.wx = 0.345702916f; p.wy = 0.358538598f;
