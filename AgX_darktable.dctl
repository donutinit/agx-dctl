    p.curve_shoulder_power = 1.5f;
    p.curve_gamma = 2.4000001f;
    p.auto_gamma = 0;
    p.curve_target_display_black_ratio = 0.0f;
    p.curve_target_display_white_ratio = 1.0f;
    p.base_primaries = 0;
    p.disable_primaries_adjustments = 0;
    p.red_inset = 0.294624507f;
    p.red_rotation = 0.0354032889f;
    p.green_inset = 0.258619249f;
    p.green_rotation = -0.0210858602f;
    p.blue_inset = 0.146413714f;
    p.blue_rotation = -0.0630572364f;
    p.master_outset_ratio = 1.0f;
    p.master_unrotation_ratio = 0.0f;
