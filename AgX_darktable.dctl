// DaVinci Wide Gamut -> Rec2020, ambos con blanco D65 (0.3127, 0.3290)
__DEVICE__ agx_mat agx_dwg_to_rec2020()
{
  return agx_mat_make(1.13030218f, -0.0255470571f, -0.0925986068f,
                      -0.0203928523f, 1.31084932f, -0.164653022f,
                      -0.109909329f, -0.28530226f, 1.25725163f);
}

// Presets de darktable (init_presets en agx.c). 1 scene-referred default, 2 blender-like base,
// 3 blender-like punchy, 4 sigmoid-like default, 5 sigmoid-like smooth, 6 smooth,
// 7 unmodified base primaries
__DEVICE__ agx_params agx_preset(int preset, agx_params p)
{
  if(preset == 1)
  {
    p.look_lift = 0.0f;
    p.look_slope = 1.0f;
    p.look_brightness = 1.0f;
    p.look_saturation = 1.0f;
    p.look_original_hue_mix_ratio = 0.600000024f;
    p.range_black_relative_ev = -10.0f;
    p.range_white_relative_ev = 6.5f;
    p.curve_pivot_x = 0.606060624f;
    p.curve_pivot_y_linear_output = 0.180000007f;
    p.curve_contrast_around_pivot = 3.0f;
    p.curve_linear_ratio_below_pivot = 0.0f;
    p.curve_linear_ratio_above_pivot = 0.0f;
    p.curve_toe_power = 1.5f;
    p.curve_shoulder_power = 3.29999995f;
    p.curve_gamma = 2.20000005f;
    p.auto_gamma = 0;
    p.curve_target_display_black_ratio = 0.0f;
    p.curve_target_display_white_ratio = 1.0f;
    p.base_primaries = 0;
    p.disable_primaries_adjustments = 0;
    p.red_inset = 0.294624507f;
    p.red_rotation = 0.0354032889f;
    p.green_inset = 0.258619249f;
    p.green_rotation = -0.0210858602f;
    p.blue_inset = 0.146413714f;
    p.blue_rotation = -0.0630572364f;
    p.master_outset_ratio = 1.0f;
    p.master_unrotation_ratio = 0.0f;
    p.red_outset = 0.290776402f;
    p.red_unrotation = 0.0354032889f;
    p.green_outset = 0.263155401f;
    p.green_unrotation = -0.0210858602f;
    p.blue_outset = 0.0458107218f;
    p.blue_unrotation = -0.0630572364f;
    p.completely_reverse_primaries = 0;
  }
  else if(preset == 2)
  {
    p.look_lift = 0.0f;
    p.look_slope = 1.0f;
    p.look_brightness = 1.0f;
    p.look_saturation = 1.0f;
