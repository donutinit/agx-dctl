// AgX de darktable para DaVinci Resolve
//
// Port a DCTL del modulo AgX de darktable 5.6.2 (src/iop/agx.c, parametros v7).
// Misma matematica, mismos parametros y mismos presets. Esta validado contra el
// codigo de darktable compilado como C: ver test/ y el README.
//
// Entra DaVinci Wide Gamut / DaVinci Intermediate (o lineal) y sale para display.
// Los sliders usan las mismas unidades que la interfaz de darktable: EV, porcentaje
// y grados. Con "preset" en "use sliders" mandan los sliders; cualquier otro preset
// los ignora (salvo input, exposure, output y show curve).
//
// AgX: Copyright (C) 2025-2026 darktable developers.
// Port a DCTL: Copyright (C) 2026 Von Diego.
// Licencia: GPL-3.0-or-later, igual que darktable. Ver LICENSE.

DEFINE_UI_PARAMS(p_preset, preset, DCTLUI_COMBO_BOX, 0, {PRESET_SLIDERS, PRESET_SCENE_DEFAULT, PRESET_BLENDER_BASE, PRESET_BLENDER_PUNCHY, PRESET_SIGMOID_DEFAULT, PRESET_SIGMOID_SMOOTH, PRESET_SMOOTH, PRESET_UNMODIFIED}, {use sliders, scene-referred default, blender-like base, blender-like punchy, sigmoid-like default, sigmoid-like smooth, smooth, unmodified base primaries})
DEFINE_UI_PARAMS(p_input, input, DCTLUI_COMBO_BOX, 0, {IN_DI_DWG, IN_LIN_DWG, IN_LIN_REC2020}, {DaVinci Intermediate DWG, Linear DWG, Linear Rec.2020})
