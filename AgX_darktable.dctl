  }
  else if(preset == 3)
  {
    p.look_lift = 0.0f;
    p.look_slope = 1.0f;
    p.look_brightness = 0.548696816f;
    p.look_saturation = 1.39999998f;
    p.look_original_hue_mix_ratio = 0.600000024f;
