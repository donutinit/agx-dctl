    p.base_to_pipe = agx_mat_make(0.877338707f, 0.0966208875f, 0.0229244363f,
                                  0.0774958208f, 0.891530991f, 0.0430439524f,
                                  0.0451655649f, 0.0118480027f, 0.934031606f);
  }
  else if(base == 3)
  {
    p.rx = 0.648438811f; p.ry = 0.330856949f; p.gx = 0.32117334f; p.gy = 0.597868383f; p.bx = 0.155893788f; p.by = 0.0660517961f;
    p.wx = 0.345702916f; p.wy = 0.358538598f;
    p.xyz_to_base = agx_mat_make(3.13423491f, -0.97874099f, 0.0719688162f,
                                 -1.61725771f, 1.91611898f, -0.229020134f,
                                 -0.4906919f, 0.0334379412f, 1.40577972f);
    p.pipe_to_base = agx_mat_make(1.660496f, -0.124547139f, -0.0181536842f,
                                  -0.587656498f, 1.13289499f, -0.100597374f,
                                  -0.0728397965f, -0.00834801607f, 1.11875105f);
